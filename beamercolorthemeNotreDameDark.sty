\ProvidesPackage{beamercolorthemeNotreDameDark}
% Adapted from beamercolorthemeNotreDame (the original dark/black-canvas
% theme, removed 2026-09) with the canvas changed from black to NDBlue,
% per Alex: "I want to go back to the dark background. I am okay with a
% blue background. I do not want a black background."
%
% Every color that used to be "the accent that reads against black" and
% happened to be NDBlue itself (itemize subitem, palette tertiary,
% sidebar secondary) is changed here to a gold variant instead -- NDBlue
% is now the canvas, so using it as a foreground/accent on top of
% itself would be invisible, the same collision found and fixed earlier
% for the frametitle bar's small logo.

\mode<presentation>

\definecolor{EmphColor}{RGB}{170,50,50}
\definecolor{HighlightBackground}{RGB}{150,80,10}
\definecolor{KeywordColor}{RGB}{50,50,150}

% Color definitions (NDGold at the official Dome Gold, #C99700 / PMS 117)
\definecolor{NDBlue}{HTML}{0C2340}
\definecolor{NDGold}{HTML}{C99700}
\definecolor{NDGold_sec}{RGB}{88,96,26}

\setbeamercolor*{normal text}{fg=white}
\setbeamercolor*{alerted text}{fg=red}
\setbeamercolor*{section text}{fg=white!80!gray}
\setbeamercolor{background canvas}{parent=normal text,bg=NDBlue}

\setbeamercolor{item projected}{bg=NDGold}
\setbeamercolor{itemize item}{fg=NDGold}
\setbeamercolor{itemize subitem}{fg=NDGold!60!white}
\setbeamercolor{description item}{fg=NDGold}
\setbeamercolor{enumerate item}{fg=NDGold}
\setbeamercolor{enumerate subitem}{fg=NDGold!60!white}

\setbeamercolor{palette primary}{fg=white,bg=NDBlue}
\setbeamercolor{palette secondary}{fg=black,bg=NDGold}
\setbeamercolor{palette tertiary}{fg=black,bg=NDGold}
\setbeamercolor{palette quaternary}{fg=black,bg=NDGold}

\setbeamercolor{titlelike}{parent=palette secondary}

\setbeamercolor{block title}{parent=palette secondary}
\setbeamercolor{block title alerted}{use=alerted text,fg=red,bg=alerted text.fg}
\setbeamercolor{block title example}{use=example text,fg=white,bg=example text.fg}

\setbeamercolor{block body}{parent=normal text,use=block title,bg=NDGold_sec}
\setbeamercolor{block body alerted}{parent=normal text,use=block title alerted,bg=NDGold_sec}
\setbeamercolor{block body example}{parent=normal text,use=block title example,bg=NDGold_sec}

% This ends up applying to most navigation-related things
\setbeamercolor{sidebar}{bg=NDGold}

\setbeamercolor{palette sidebar primary}{fg=white}
\setbeamercolor{palette sidebar secondary}{fg=NDGold!60!white}

\setbeamercolor*{separation line}{bg=NDGold}
\setbeamercolor*{fine separation line}{bg=NDGold}

\mode
<all>
