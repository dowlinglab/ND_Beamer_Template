\ProvidesPackage{beamerthemeNotreDame}

% Adapted from the University of Oregon theme (http://ix.cs.uoregon.edu/~peter/uotheme/)
% and also from some mangled pieces of the default theme.  That probably puts this under
% GPLv2.
%
% Forked and modernized by the Dowling Lab, September 2026. See README
% for the full current option list. Highlights, in order:
%  - Replaced the hardcoded College-of-Science logo/titlegraphic with real,
%    current official Notre Dame marks (no college sub-branding).
%  - Fixed [sections] (now [sectionbar]) to actually display the current
%    section name -- it previously added a colored bar with no content.
%  - Removed [compactlogo] -- a documented no-op in the upstream template
%    (both its code branches were identical).
%  - Corrected NDGold to the official Dome Gold (#C99700 / PMS 117); the
%    upstream value (#AE8F40) was never the University's actual color.
%  - Added [cornerlogo] and \ndlogonote: a small mark in the bottom-left
%    corner of every frame, plus a companion note box beside it,
%    promoted from a pattern built ad hoc, per-deck, before this fork
%    existed.
%  - Went through two intermediate designs (a single [white]/[dark]
%    toggle with per-element colors cascading from it) before landing
%    on the current one: every visual element -- the title bar, the
%    section-name bar, the title text, the canvas, the body text, the
%    corner logo, the frametitle-bar monogram, and the title-page mark
%    -- is its OWN independent color choice (see README), each with a
%    sensible default but fully overridable, per Alex's own inventory
%    of "options I am seeing" and his enumeration of each one's real
%    choices. No black-canvas option anywhere in that history; the two
%    canvas choices are white and NDBlue.
%  - Per Alex, quoting Notre Dame's own guidelines directly: "the
%    secondary academic mark or monogram should only be used when space
%    does not allow the primary academic mark." The title page therefore
%    always uses the primary (wide) mark regardless of [mark] -- there's
%    always room on a title page -- while [mark] itself now governs only
%    the corner logo, which is the one placement genuinely space-
%    constrained enough to warrant the secondary mark as an option.

\RequirePackage{etoolbox}
\RequirePackage{xkeyval}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\usepackage{tabularx}
\RequirePackage{xcolor}

% Color definitions, consolidated here now that every element's color is
% its own independent option rather than a choice between two preset
% \usecolortheme files (beamercolorthemeNotreDame{,White}.sty, both now
% retired) -- NDBlue and NDGold are the two real ND colors this whole
% option system maps every semantic name onto (see \nd@setcolor below).
% The rest (EmphColor, HighlightBackground, KeywordColor, NDGold_sec)
% carry over from those retired files for anyone still using the
% \Highlight snippet documented in the README.
\definecolor{NDBlue}{HTML}{0C2340}
\definecolor{NDGold}{HTML}{C99700}
\definecolor{IrishGreen}{HTML}{00843D}
\definecolor{NDGold_sec}{RGB}{230,212,124}
\definecolor{EmphColor}{RGB}{153,1,0}
\definecolor{HighlightBackground}{RGB}{255,255,0}
\definecolor{KeywordColor}{RGB}{0,0,95}

%% The options for this template
%
% NOTE on implementation: plain \DeclareOptionBeamer/\ProcessOptionsBeamer
% (thin wrappers around LaTeX's own \DeclareOption/\ProcessOptions) cannot
% match "key=value"-shaped option strings -- tested directly: declaring
% \DeclareOptionBeamer{logo=black} and passing [logo=black] silently fails
% to match, falling through to the default every time. So every option
% here, including the plain on/off switches that upstream declared with
% \DeclareOptionBeamer, is declared as an xkeyval \define@key instead (the
% boolean ones with a [true] default, so bare `nav` still means
% `nav=true`), all processed together in one \ProcessOptionsX<ND> call.

% If this option [nav] is present, include the navigation buttons in
% the lower right corner.  The default is no navigation buttons
\newif\ifbeamer@nav
\beamer@navfalse
\define@key{ND}{nav}[true]{\csname beamer@nav#1\endcsname}

% The option [noslidenumbers] suppresses the display of slide numbers.
% Slide numbers are shown by default
\newif\ifbeamer@noslidenumbers
\beamer@noslidenumbersfalse
\define@key{ND}{noslidenumbers}[true]{\csname beamer@noslidenumbers#1\endcsname}

\newif\ifbeamer@fullFooter
\beamer@fullFooterfalse
\define@key{ND}{fullFooter}[true]{\csname beamer@fullFooter#1\endcsname}

% --- The independent style options ------------------------------------
% Each is its own choice with its own sensible default (noted per key),
% not derived from a single overall "mode" -- but several defaults do
% still consult [background], the one choice everything else most
% naturally reads against.

% background: the canvas. white (default) or blue (NDBlue -- there is
% no black canvas option, deliberately, per Alex's own call).
\def\nd@background{white}
\define@key{ND}{background}{\def\nd@background{#1}}

% titlebar: the frametitle bar's own background. blue, gold, or none
% (no colored box at all -- the title text then sits directly on the
% canvas). Default: whichever of blue/gold contrasts with [background]
% (blue bar on the white canvas, gold bar on the blue canvas) -- the
% same "always the other main color" convention this theme has used
% throughout its history.
\let\nd@titlebar\undefined
\define@key{ND}{titlebar}{\def\nd@titlebar{#1}}

% sectionbar: the section-name bar above the title. blue, gold, or none
% (default -- no bar, no section name shown, regardless of whether the
% document actually has \section commands).
\def\nd@sectionbar{none}
\define@key{ND}{sectionbar}{\def\nd@sectionbar{#1}}

% titlecolor: the frametitle TEXT color. blue, gold, black, or white.
% Default: derived from [titlebar] if it has a color (white text on the
% blue bar, black text on the gold bar, matching this theme's existing
% palette pairings) or from [background] if [titlebar] is none (blue
% text on the white canvas, white text on the blue canvas -- the same
% pairing [textcolor] itself defaults to).
\let\nd@titlecolor\undefined
\define@key{ND}{titlecolor}{\def\nd@titlecolor{#1}}

% textcolor: body text color. black, blue, gold, or white. Default:
% derived from [background] (blue text on white, white text on blue).
% Unlike earlier versions of this theme, this is NOT force-overridden
% on the blue background -- every combination is available since every
% element is now an independent choice; a low-contrast combination
% (e.g. background=blue, textcolor=blue) is possible to ask for and is
% not blocked, the same way [titlebar]=[titlecolor] both gold would be.
\let\nd@textcolor\undefined
\define@key{ND}{textcolor}{\def\nd@textcolor{#1}}

% cornerlogo: the small academic mark in the bottom-left corner of
% every content frame (drawn via \ndcornerlogo, independent of the
% frametitle bar's own monogram below). blue, gold, black, white,
% fullcolor, or none (default -- no corner logo, matching this option's
% original on/off-only design before it grew a color choice). Shape
% (which mark) is set separately, by [mark].
\def\nd@cornerlogo{none}
\define@key{ND}{cornerlogo}{\def\nd@cornerlogo{#1}}

% monogram: the small monogram inside the frametitle bar (this theme's
% only asset that isn't the full academic mark -- just the "ND"
% letterform, for the one placement tight enough to need it). blue,
% gold, gold-metallic, white, or none. Default: whichever contrasts
% with [titlebar] (white on the blue bar, blue on the gold bar) --
% FOUND BY TESTING 2026-09, repeatedly: using the same color as [logo]/
% [cornerlogo] here put a blue monogram on a blue bar and a gold
% monogram on a gold bar, both invisible. If [titlebar] is none, there
% is no bar for the monogram to sit in, so it is forced to none
% regardless of this key -- an orphaned logo floating with no visual
% anchor isn't a real option here.
\let\nd@monogram\undefined
\define@key{ND}{monogram}{\def\nd@monogram{#1}}

% titlepagelogo: the large academic mark on the title page. blue, gold,
% black, white, fullcolor, or none. Default: derived from [background]
% (blue on white, gold on blue), the same pairing [cornerlogo] would
% use if defaulted the same way. ALWAYS the primary (wide) mark,
% regardless of [mark] -- per Alex, quoting Notre Dame's own
% guidelines: the secondary mark/monogram are for when space doesn't
% allow the primary one, and a title page always has the room.
\let\nd@titlepagelogo\undefined
\define@key{ND}{titlepagelogo}{\def\nd@titlepagelogo{#1}}

% mark: which academic-mark shape the CORNER logo uses (the title page
% is always the primary mark -- see titlepagelogo above). primary
% (default) is the wide lockup, shield beside "University of Notre
% Dame"; secondary is the compact vertical lockup, shield above "Notre
% Dame," for when the corner is too tight for the primary mark.
\def\nd@mark{primary}
\define@key{ND}{mark}{\def\nd@mark{#1}}

% highlight: the presentation-wide default color for \hl{...} (see
% below) when it's called with no color argument. gold, green (Irish
% Green), blue, or none (bold, no color change at all). Default: gold.
\def\nd@highlightdefault{gold}
\define@key{ND}{highlight}{\def\nd@highlightdefault{#1}}

\ProcessOptionsX<ND>

% --- Resolve every default that depends on another option's value ----
% (in dependency order: background first, since several others read it)
\ifx\nd@titlebar\undefined
  \ifdefstring{\nd@background}{blue}{\def\nd@titlebar{gold}}{\def\nd@titlebar{blue}}
\fi
\ifx\nd@textcolor\undefined
  \ifdefstring{\nd@background}{blue}{\def\nd@textcolor{white}}{\def\nd@textcolor{blue}}
\fi
\ifx\nd@titlepagelogo\undefined
  \ifdefstring{\nd@background}{blue}{\def\nd@titlepagelogo{gold}}{\def\nd@titlepagelogo{blue}}
\fi
\ifx\nd@titlecolor\undefined
  \ifdefstring{\nd@titlebar}{blue}{\def\nd@titlecolor{white}}{%
  \ifdefstring{\nd@titlebar}{gold}{\def\nd@titlecolor{black}}{%
  \ifdefstring{\nd@background}{blue}{\def\nd@titlecolor{white}}{\def\nd@titlecolor{blue}}%
  }}
\fi
\ifx\nd@monogram\undefined
  \ifdefstring{\nd@titlebar}{blue}{\def\nd@monogram{white}}{%
  \ifdefstring{\nd@titlebar}{gold}{\def\nd@monogram{blue}}{\def\nd@monogram{none}}%
  }
\fi
\ifdefstring{\nd@titlebar}{none}{\def\nd@monogram{none}}{}

\mode<presentation>

% --- Color mapping helpers ---------------------------------------------
% Every color key above takes a semantic name (blue, gold, black,
% white); map each to the real \colorlet this theme actually defines.
\newcommand{\nd@setcolor}[2]{% #1 = macro to define, #2 = semantic name
  \ifdefstring{#2}{blue}{\colorlet{#1}{NDBlue}}{%
  \ifdefstring{#2}{gold}{\colorlet{#1}{NDGold}}{%
  \ifdefstring{#2}{black}{\colorlet{#1}{black}}{%
  \ifdefstring{#2}{white}{\colorlet{#1}{white}}{%
  \colorlet{#1}{black}% fallback, should not be reached for real values
  }}}}%
}
\nd@setcolor{nd@titlebarcolor}{\nd@titlebar}
\nd@setcolor{nd@sectionbarcolor}{\nd@sectionbar}
\nd@setcolor{nd@titlecolorreal}{\nd@titlecolor}
\nd@setcolor{nd@textcolorreal}{\nd@textcolor}
\nd@setcolor{nd@backgroundcolor}{\nd@background}

% \hl[color]{text} -- bold a phrase for emphasis, per Alex's own real
% style ("I like to bold words in a phrase to add emphasis"), and
% optionally color it one of the three real ND accent colors. With no
% [color], uses whichever color [highlight] resolved to for the whole
% deck (default gold); \hl[none]{...} always just bolds, regardless of
% [highlight] -- a per-call escape hatch, not tied to the deck default.
% \hl[gold|green|blue]{...} always uses that color for this one call,
% regardless of [highlight].
\newcommand{\hl}[2][]{%
  \def\nd@hlarg{#1}%
  \ifx\nd@hlarg\@empty
    \edef\nd@hlcolor{\nd@highlightdefault}%
  \else
    \edef\nd@hlcolor{#1}%
  \fi
  \ifdefstring{\nd@hlcolor}{none}{\textbf{#2}}{%
  \ifdefstring{\nd@hlcolor}{gold}{\textbf{\color{NDGold}#2}}{%
  \ifdefstring{\nd@hlcolor}{green}{\textbf{\color{IrishGreen}#2}}{%
  \ifdefstring{\nd@hlcolor}{blue}{\textbf{\color{NDBlue}#2}}{%
  \textbf{#2}% fallback, should not be reached for real values
  }}}}%
}

\setbeamertemplate{frametitle}[default][center]
% Removes the logo from the lower right so that we can place it less obtrusively
\defbeamertemplate*{sidebar right}{notredame theme}
{
  \vfill%
  \llap{\usebeamertemplate***{navigation symbols}\hskip0.1cm}%
  \vskip2pt%
}

% Redefine the frameheader to include a logo. Two shapes, depending on
% [titlebar]: the original colored beamercolorbox (titlebar != none), or
% (titlebar == none) plain title text directly on the canvas, no box,
% no logo slot (the monogram is forced to none in this case already).
\ifdefstring{\nd@titlebar}{none}{%
  \defbeamertemplate*{frametitle}{notredame theme}[1][left]
  {
    \vskip1.4ex%
    {\usebeamerfont{frametitle}\color{nd@titlecolorreal}\insertframetitle\strut\par}%
    {%
      \ifx\insertframesubtitle\@empty%
      \else%
      {\usebeamerfont{framesubtitle}\color{nd@titlecolorreal}\insertframesubtitle\strut\par}%
      \fi
    }%
    \vskip0.6ex%
  }
}{%
  \defbeamertemplate*{frametitle}{notredame theme}[1][left]
  {
    \ifbeamercolorempty[bg]{frametitle}{}{\nointerlineskip}%
    \@tempdima=\textwidth%
    \advance\@tempdima by\beamer@leftmargin%
    \advance\@tempdima by\beamer@rightmargin%
    \begin{beamercolorbox}[sep=0.3cm,#1,wd=\the\@tempdima]{frametitle}
      \usebeamerfont{frametitle}%
      \vbox{}\vskip-1ex%
      \if@tempswa\else\csname beamer@fte#1\endcsname\fi%
      \begin{tabularx}{.95\@tempdima}{lXr}
        \ifdefstring{\nd@monogram}{none}{%
          \insertframetitle & &
        }{%
          \insertframetitle & & \insertlogo
        }
      \end{tabularx}\par%
      {%
        \ifx\insertframesubtitle\@empty%
        \else%
        {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\strut\par}%
        \fi
      }%
      \vskip-1ex%
      \if@tempswa\else\vskip-.3cm\fi% set inside beamercolorbox... evil here...
    \end{beamercolorbox}%
  }
}


\useinnertheme{circles}

% Circles are much nicer for bullet points, but the circles
% inner theme does not give you rounded boxes.  Override these
% settings as in the rounded theme.
\setbeamertemplate{title page}[default][colsep=-4bp,rounded=true]
\setbeamertemplate{blocks}[rounded]

\defbeamertemplate*{footline}{footTitleAuthorDate}
{
  \leavevmode%
  \hbox{%
  \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
    \usebeamerfont{title in head/foot}\insertshorttitle
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
    \usebeamerfont{author in head/foot}\insertshortauthor\expandafter\beamer@ifempty\expandafter{\beamer@shortinstitute}{}{~~\insertshortinstitute}
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,right]{title in head/foot}%
    \usebeamerfont{date in head/foot}\insertshortdate{}\hspace*{2em}
    \insertframenumber{} / \inserttotalframenumber\hspace*{2ex}
  \end{beamercolorbox}}%
  \vskip0pt%
}

\defbeamertemplate*{footline}{footerSimple}
{
  \leavevmode%
  \makebox[\paperwidth][r]{\insertframenumber{} / \inserttotalframenumber{}\hspace*{1ex}}%
  \vspace*{1ex}%
  \vskip0pt%
}

\setbeamersize{text margin left=1em,text margin right=1em}

%%%%%% Apply the resolved colors %%%%%%

% Canvas and body text -- the two colors nearly everything else reads
% against.
\setbeamercolor{background canvas}{bg=nd@backgroundcolor}
\setbeamercolor*{normal text}{fg=nd@textcolorreal}
\setbeamercolor*{alerted text}{fg=red}

% Bullet/list colors: NDBlue and NDGold, whichever isn't the background
% (matching this theme's own established convention), so they stay
% visible regardless of [background].
\ifdefstring{\nd@background}{blue}{%
  \setbeamercolor{itemize item}{fg=NDGold}
  \setbeamercolor{itemize subitem}{fg=NDGold!60!white}
  \setbeamercolor{enumerate item}{fg=NDGold}
  \setbeamercolor{enumerate subitem}{fg=NDGold!60!white}
  \setbeamercolor{description item}{fg=NDGold}
}{%
  \setbeamercolor{itemize item}{fg=NDBlue}
  \setbeamercolor{itemize subitem}{fg=NDGold}
  \setbeamercolor{enumerate item}{fg=NDBlue}
  \setbeamercolor{enumerate subitem}{fg=NDGold}
  \setbeamercolor{description item}{fg=NDBlue}
}

% Frametitle bar (titlebar != none): background + text color, both
% independent choices now rather than a fixed palette pairing. Also
% covers "titlelike" (the *title page's* title, a separate beamer color
% from the per-slide frametitle above) with the same pairing -- FOUND
% BY TESTING 2026-09: this used to come for free from the two retired
% \usecolortheme files (each set titlelike=parent=palette secondary);
% deleting them without an explicit replacement here left the title
% page's title in beamer's own bland fallback (a generic bluish-purple,
% no background box at all) instead of this theme's actual colors.
\ifdefstring{\nd@titlebar}{none}{%
  \setbeamercolor{titlelike}{bg=,fg=nd@titlecolorreal}
}{%
  \setbeamercolor{frametitle}{bg=nd@titlebarcolor,fg=nd@titlecolorreal}
  \setbeamercolor*{title in head/foot}{bg=nd@titlebarcolor,fg=nd@titlecolorreal}
  \setbeamercolor{titlelike}{bg=nd@titlebarcolor,fg=nd@titlecolorreal}
}
\setbeamercolor*{page in head/foot}{fg=nd@textcolorreal}

% [sectionbar]: show the current section name in its own colored bar
% above the title. REBUILT 2026-09 -- the upstream version called
% \useoutertheme{miniframes}, which added a colored bar but never
% actually displayed a section name or progress dots in this theme (the
% custom frametitle template above doesn't integrate with miniframes'
% own headline machinery). This is a direct, working headline template
% instead of trying to coax miniframes into cooperating with a
% frametitle template it wasn't designed for.
\ifdefstring{\nd@sectionbar}{none}{}{%
  \setbeamercolor{section in head/foot}{bg=nd@sectionbarcolor,fg=nd@titlecolorreal}
  \setbeamerfont{section in head/foot}{series=\bfseries}
  \setbeamertemplate{headline}{%
    \ifx\insertsectionhead\@empty\else
      \begin{beamercolorbox}[wd=\paperwidth,ht=3.2ex,dp=1.2ex,center]{section in head/foot}
        \usebeamerfont{section in head/foot}\insertsectionhead
      \end{beamercolorbox}%
    \fi
  }
}

% --- Logo and title-page graphic --------------------------------------
% No college sub-branding anywhere: every mark is the plain university
% mark. The title page is always the PRIMARY (wide) mark -- see the
% [titlepagelogo] comment above for why -- in the color [titlepagelogo]
% resolves to; [titlepagelogo]=none omits it.
%
% Placement: bottom-left corner, not centered under the author block.
% ORIGINALLY used plain \titlegraphic{...}, which beamer's own default
% title-page template centers, small, below the author/date block --
% Alex, seeing it rendered: "I don't want the ND logo centered; instead,
% I want it larger in the lower-left corner. I like it better." Uses
% the same overlay technique as \ndcornerlogo (TikZ remember-picture,
% anchored to the physical page corner) instead of \titlegraphic.
%
% \ndtitlepagelogodraw is a plain command, NOT wired up automatically
% via \addtobeamertemplate{title page}{\setbeamertemplate{background}
% {...}}{} -- that was the first approach tried, and it silently drew
% the WRONG logo (whatever [cornerlogo]/[mark] resolved to, not
% [titlepagelogo]/primary). FOUND BY TESTING 2026-09, via a minimal
% isolated case (a background swapped this way inside a template's own
% before-hook stayed the OLD background on the very page that set it):
% Beamer locks in which background template a frame uses at
% \begin{frame} time, before the frame's own content -- including
% \titlepage itself -- has run. A change made from inside \titlepage's
% own hook is simply too late for that same frame.
% So the deck sets the title page's background itself, from OUTSIDE
% \begin{frame} -- exactly like this same template's nav-symbols line
% already does in main.tex (confirmed working the same way, by the same
% isolated test):
%   {
%   \setbeamertemplate{navigation symbols}{}
%   \setbeamertemplate{background}{\ndtitlepagelogodraw}
%   \begin{frame}[plain]
%     \titlepage
%   \end{frame}
%   }
% \ndtitlepagelogodraw is always defined (empty when [titlepagelogo]=
% none) so a deck can reference it unconditionally.
\newcommand{\ndtitlepagelogomargin}{0.15mm}
\newcommand{\ndtitlepagelogoheight}{2.6cm}
\newcommand{\ndtitlepagelogodraw}{}
\ifdefstring{\nd@titlepagelogo}{none}{}{%
  \renewcommand{\ndtitlepagelogodraw}{%
    \begin{tikzpicture}[remember picture, overlay]
      \node[anchor=south west, xshift=\ndtitlepagelogomargin, yshift=\ndtitlepagelogomargin]
        at (current page.south west)
        {\includegraphics[height=\ndtitlepagelogoheight]{logos/academic-mark/primary/\nd@titlepagelogo}};
    \end{tikzpicture}%
  }
}

% The small monogram inside the frametitle bar (only relevant when
% [titlebar] != none; forced to none otherwise, resolved above).
\ifdefstring{\nd@monogram}{none}{%
  \newif\ifbeamer@nologo \beamer@nologotrue
}{%
  \newif\ifbeamer@nologo \beamer@nologofalse
  \logo{\includegraphics[height=0.6cm]{logos/monogram/\nd@monogram}}
}

% --- Corner logo and its companion note box ---------------------------
% Promoted from a pattern built ad hoc, per-deck, before this fork
% existed: a small academic mark sitting in the bottom-left corner of
% every content frame, independent of the frametitle bar's own
% monogram above. [cornerlogo]=none (the default) omits it entirely.
%
% \ndcornerlogomargin controls how close it sits to the page edge --
% some margin avoids a projector/printer clipping it outright, but
% Alex's call 2026-09 is to push it tighter into the corner than the
% original per-deck version (which used 0.5mm): 0.15mm here. Override
% with \renewcommand{\ndcornerlogomargin}{...} before \begin{document}
% if a specific deck wants something else.
\newcommand{\ndcornerlogomargin}{0.15mm}
% \ndcornerlogoheight started at the size tuned, by eye, against the
% primary mark in the Dowling Lab's own seminar deck (0.2475 of a
% 12.8cm-wide slide, at that mark's 2.42:1 aspect ratio, works out to
% ~1.3cm tall) -- height-based rather than width-based so it stays a
% consistent vertical footprint regardless of [mark]'s aspect ratio.
% Alex's call 2026-09, seeing it rendered against these marks' real
% (tighter-cropped) proportions: too big at 1.3cm -- shrunk to 75%.
\newcommand{\ndcornerlogoheight}{0.975cm}

\ifdefstring{\nd@cornerlogo}{none}{}{%
  \newsavebox{\nd@cornerlogobox}
  \savebox{\nd@cornerlogobox}{\includegraphics[height=\ndcornerlogoheight]{logos/academic-mark/\nd@mark/\nd@cornerlogo}}
  \newlength{\ndcornerlogowidth}
  \settowidth{\ndcornerlogowidth}{\usebox{\nd@cornerlogobox}}

  % \ndcornerlogo -- draws the corner logo. Called automatically as the
  % frame background whenever [cornerlogo] is not none; can also be
  % called directly (e.g. \setbeamertemplate{background}{\ndcornerlogo})
  % from a specific deck for more control.
  \newcommand{\ndcornerlogo}{%
    \begin{tikzpicture}[remember picture, overlay]
      \node[anchor=south west, xshift=\ndcornerlogomargin, yshift=\ndcornerlogomargin]
        at (current page.south west) {\usebox{\nd@cornerlogobox}};
    \end{tikzpicture}%
  }
  \setbeamertemplate{background}{\ndcornerlogo}

  % \ndlogonote[align]{text} -- a note box in the white space to the
  % right of the corner logo: horizontally centered between the logo's
  % right edge and the slide's right edge, vertically centered on the
  % logo's own vertical middle. For a short takeaway line (the common
  % case, [align] defaults to center) or a left-aligned reference list
  % (pass [left]). Measures the logo's actual rendered size, so it
  % stays aligned with whichever [mark] is active. Only defined when
  % [cornerlogo] is not none, since it positions itself relative to
  % that logo's measured size.
  \newlength{\nd@notegap}
  \setlength{\nd@notegap}{4mm}
  \newlength{\nd@noteRmargin}
  \setlength{\nd@noteRmargin}{3mm}
  \newcommand{\ndlogonote}[2][center]{%
    \begin{tikzpicture}[remember picture, overlay]
      \coordinate (nd@logoR) at ($(current page.south west) + (\ndcornerlogomargin+\ndcornerlogowidth+\nd@notegap, \ndcornerlogomargin+0.5*\ndcornerlogoheight)$);
      \coordinate (nd@pageR) at ($(current page.south east) + (-\nd@noteRmargin, \ndcornerlogomargin+0.5*\ndcornerlogoheight)$);
      \node[anchor=center, align=#1,
            text width=\dimexpr\paperwidth-\ndcornerlogomargin-\ndcornerlogowidth-\nd@notegap-\nd@noteRmargin\relax]
        at ($(nd@logoR)!0.5!(nd@pageR)$) {#2};
    \end{tikzpicture}%
  }
}

% Disable the navigation bar unless it was explicitly requested
\ifbeamer@nav
\else
  \setbeamertemplate{navigation symbols}{}
\fi

\ifbeamer@fullFooter
	\setbeamertemplate{footline}[footTitleAuthorDate]
\else
