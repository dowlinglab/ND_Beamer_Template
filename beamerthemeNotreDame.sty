\ProvidesPackage{beamerthemeNotreDame}

% Adapted from the University of Oregon theme (http://ix.cs.uoregon.edu/~peter/uotheme/)
% and also from some mangled pieces of the default theme.  That probably puts this under
% GPLv2.
%
% Forked and modernized by the Dowling Lab, September 2026:
%  - Replaced the hardcoded College-of-Science logo/titlegraphic with real,
%    current official Notre Dame marks (no college sub-branding).
%  - Added `mark`, `logo`, and `textcolor` options (see README) so the logo
%    shape, logo color, and body-text color are all configurable instead of
%    hardcoded.
%  - Fixed `sections` to actually display the current section name (it
%    previously added a colored bar with no content).
%  - Removed `compactlogo` -- it was a documented no-op in the upstream
%    template (both its code branches were identical).
%  - Removed the dark (black-background) color theme and the `white`
%    option that switched to it -- Alex's call: "I do not like the black
%    background. We can drop it." This theme is always the light/white
%    background now; beamercolorthemeNotreDame.sty (the dark one) is no
%    longer used. `logo=black`/`textcolor=black` remain available and
%    valid -- that's a black mark and black text ON the white
%    background, a different thing from the dark canvas that's gone.
%  - Corrected NDGold to the official Dome Gold (#C99700 / PMS 117); the
%    upstream value (#AE8F40) was never the University's actual color.
%  - Added `cornerlogo`, \ndcornerlogo, and \ndlogonote: a small mark in
%    the bottom-left corner of every frame, plus a companion note box
%    beside it, promoted from a pattern built ad hoc, per-deck, before
%    this fork existed.

\RequirePackage{etoolbox}
\RequirePackage{xkeyval}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\usepackage{tabularx}

%% The options for this template
%
% NOTE on implementation: plain \DeclareOptionBeamer/\ProcessOptionsBeamer
% (thin wrappers around LaTeX's own \DeclareOption/\ProcessOptions) cannot
% match "key=value"-shaped option strings -- tested directly: declaring
% \DeclareOptionBeamer{logo=black} and passing [logo=black] silently fails
% to match, falling through to the default every time. So every option
% here, including the plain on/off switches that upstream declared with
% \DeclareOptionBeamer, is declared as an xkeyval \define@key instead (the
% boolean ones with a [true] default, so bare `nav` still means
% `nav=true`), all processed together in one \ProcessOptionsX<ND> call.

% If this option [nav] is present, include the navigation buttons in
% the lower right corner.  The default is no navigation buttons
\newif\ifbeamer@nav
\beamer@navfalse
\define@key{ND}{nav}[true]{\csname beamer@nav#1\endcsname}

% If the option [nologo] is provided, the logo on the right side of
% the slide title is suppressed.  The logo is on by default.
\newif\ifbeamer@nologo
\beamer@nologofalse
\define@key{ND}{nologo}[true]{\csname beamer@nologo#1\endcsname}

% The option [sections] shows the current section name under the slide
% title.  There are no sections shown by default.
\newif\ifbeamer@sections
\beamer@sectionsfalse
\define@key{ND}{sections}[true]{\csname beamer@sections#1\endcsname}

% The option [noslidenumbers] suppresses the display of slide numbers.
% Slide numbers are shown by default
\newif\ifbeamer@noslidenumbers
\beamer@noslidenumbersfalse
\define@key{ND}{noslidenumbers}[true]{\csname beamer@noslidenumbers#1\endcsname}

\newif\ifbeamer@fullFooter
\beamer@fullFooterfalse
\define@key{ND}{fullFooter}[true]{\csname beamer@fullFooter#1\endcsname}

% The option [cornerlogo] draws a small academic mark in the bottom-left
% corner of every content frame (independent of [nologo], which only
% controls the small top-right in-title-bar logo). Promoted from a
% pattern the Dowling Lab built ad hoc, per-deck, before this fork
% existed -- see \ndcornerlogo and \ndlogonote below.
\newif\ifbeamer@cornerlogo
\beamer@cornerlogofalse
\define@key{ND}{cornerlogo}[true]{\csname beamer@cornerlogo#1\endcsname}

% --- Mark shape: which academic-mark lockup to use -------------------
% primary   = wide lockup, shield beside "University of Notre Dame"
% secondary = compact vertical lockup, shield above "Notre Dame"
\def\nd@mark{primary}
\define@key{ND}{mark}{\def\nd@mark{#1}}

% --- Logo color: which color variant of the mark/monogram to use -----
% fullcolor, black, blue, gold, gold-metallic, white (reverse). Left
% undefined here so we can tell, after \ProcessOptionsX, whether the
% user chose one explicitly or whether we should default it (blue).
\let\nd@logo\undefined
\define@key{ND}{logo}{\def\nd@logo{#1}}

% --- Text color: body text color -------------------------------------
% Left undefined so we can default it from the resolved logo color
% (black logo -> black text) unless the user picked one explicitly.
\let\nd@textcolor\undefined
\define@key{ND}{textcolor}{\def\nd@textcolor{#1}}

\ProcessOptionsX<ND>

% Resolve the logo-color default: blue, unless the user picked one
% explicitly.
\ifx\nd@logo\undefined
  \def\nd@logo{blue}
\fi

% Resolve the text-color default: black only follows from an explicit
% black LOGO choice; every other logo color defaults text to blue.
\ifx\nd@textcolor\undefined
  \ifdefstring{\nd@logo}{black}{\def\nd@textcolor{black}}{\def\nd@textcolor{blue}}
\fi

\mode<presentation>

\setbeamertemplate{frametitle}[default][center]
% Removes the logo from the lower right so that we can place it less obtrusively
\defbeamertemplate*{sidebar right}{notredame theme}
{
  \vfill%
  \llap{\usebeamertemplate***{navigation symbols}\hskip0.1cm}%
  \vskip2pt%
}

% Redefine the frameheader to include a logo
\defbeamertemplate*{frametitle}{notredame theme}[1][left]
{
  \ifbeamercolorempty[bg]{frametitle}{}{\nointerlineskip}%
  \@tempdima=\textwidth%
  \advance\@tempdima by\beamer@leftmargin%
  \advance\@tempdima by\beamer@rightmargin%
  \begin{beamercolorbox}[sep=0.3cm,#1,wd=\the\@tempdima]{frametitle}
    \usebeamerfont{frametitle}%
    \vbox{}\vskip-1ex%
    \if@tempswa\else\csname beamer@fte#1\endcsname\fi%
    \begin{tabularx}{.95\@tempdima}{lXr}
      \ifbeamer@nologo
        \insertframetitle & &
      \else
        \insertframetitle & & \insertlogo
      \fi
    \end{tabularx}\par%
    {%
      \ifx\insertframesubtitle\@empty%
      \else%
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\strut\par}%
      \fi
    }%
    \vskip-1ex%
    \if@tempswa\else\vskip-.3cm\fi% set inside beamercolorbox... evil here...
  \end{beamercolorbox}%
}


\useinnertheme{circles}

% Circles are much nicer for bullet points, but the circles
% inner theme does not give you rounded boxes.  Override these
% settings as in the rounded theme.
\setbeamertemplate{title page}[default][colsep=-4bp,rounded=true]
\setbeamertemplate{blocks}[rounded]

% \setbeamercolor*{author in head/foot}{parent=palette tertiary}
\setbeamercolor*{title in head/foot}{parent=palette secondary}
\setbeamercolor*{page in head/foot}{parent=palette primary}

% \setbeamercolor*{section in head/foot}{parent=palette tertiary}
% \setbeamercolor*{subsection in head/foot}{parent=palette primary}

\defbeamertemplate*{footline}{footTitleAuthorDate}
{
  \leavevmode%
  \hbox{%
  \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
    \usebeamerfont{title in head/foot}\insertshorttitle
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
    \usebeamerfont{author in head/foot}\insertshortauthor\expandafter\beamer@ifempty\expandafter{\beamer@shortinstitute}{}{~~\insertshortinstitute}
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,right]{title in head/foot}%
    \usebeamerfont{date in head/foot}\insertshortdate{}\hspace*{2em}
    \insertframenumber{} / \inserttotalframenumber\hspace*{2ex}
  \end{beamercolorbox}}%
  \vskip0pt%
}

\defbeamertemplate*{footline}{footerSimple}
{
  \leavevmode%
  \makebox[\paperwidth][r]{\insertframenumber{} / \inserttotalframenumber{}\hspace*{1ex}}%
  \vspace*{1ex}%
  \vskip0pt%
}

\setbeamersize{text margin left=1em,text margin right=1em}

%%%%%% IF SWITCHES %%%%%%

% [sections]: show the current section name in a colored bar under the
% slide title. REBUILT 2026-09 -- the upstream version called
% \useoutertheme{miniframes}, which added the colored bar but never
% actually displayed a section name or progress dots in this theme (the
% custom frametitle template above doesn't integrate with miniframes'
% own headline machinery). This replaces it with a direct, working
% headline template instead of trying to coax miniframes into
% cooperating with a frametitle template it wasn't designed for.
\ifbeamer@sections
  \setbeamercolor{section in head/foot}{parent=palette tertiary}
  \setbeamerfont{section in head/foot}{series=\bfseries}
  \setbeamertemplate{headline}{%
    \ifx\insertsectionhead\@empty\else
      \begin{beamercolorbox}[wd=\paperwidth,ht=3.2ex,dp=1.2ex,center]{section in head/foot}
        \usebeamerfont{section in head/foot}\insertsectionhead
      \end{beamercolorbox}%
    \fi
  }
\fi

\usecolortheme{NotreDameWhite}

% Body-text color, per [textcolor] (default blue, or black if [logo] is
% black and [textcolor] wasn't given explicitly -- resolved above).
\ifdefstring{\nd@textcolor}{black}{%
  \setbeamercolor*{normal text}{fg=black}
}{%
  \setbeamercolor*{normal text}{fg=NDBlue}
}

% --- Logo and title-page graphic --------------------------------------
% No college sub-branding: both marks are the plain university marks.
% The title page uses the full academic mark, in the [mark] shape and
% [logo] color chosen -- it sits on the plain white body background, so
% every [logo] color choice (including black) reads correctly there.
\titlegraphic{\includegraphics[height=1.5cm]{logos/academic-mark/\nd@mark/\nd@logo}}

% The small top-right \logo (suppressed by [nologo]) is a different
% story: it sits INSIDE the frametitle bar, whose background is the
% "palette secondary" color -- NDBlue. FOUND BY TESTING 2026-09: using
% \nd@logo's resolved color there put a blue monogram on a blue bar --
% effectively invisible when [logo] is blue (the default). This logo is
% therefore always the white/reverse monogram, which contrasts with
% that navy bar regardless of what [logo] resolves to elsewhere -- not
% a style choice, the alternative is an invisible logo whenever [logo]
% happens to be blue.
\logo{\includegraphics[height=0.6cm]{logos/monogram/white}}

% --- Corner logo and its companion note box ---------------------------
% Promoted from a pattern built ad hoc, per-deck, before this fork
% existed: a small academic mark sitting in the bottom-left corner of
% every content frame, independent of the top-right \logo above.
%
% \ndcornerlogomargin controls how close it sits to the page edge --
% some margin avoids a projector/printer clipping it outright, but
% Alex's call 2026-09 is to push it tighter into the corner than the
% original per-deck version (which used 0.5mm): 0.15mm here. Override
% with \renewcommand{\ndcornerlogomargin}{...} before \begin{document}
% if a specific deck wants something else.
\newcommand{\ndcornerlogomargin}{0.15mm}
% \ndcornerlogoheight matches the size already tuned, by eye, against
% the primary mark in the Dowling Lab's own seminar deck (0.2475 of a
% 12.8cm-wide slide, at that mark's 2.42:1 aspect ratio, works out to
% ~1.3cm tall) -- height-based rather than width-based so it stays a
% consistent vertical footprint regardless of [mark]'s aspect ratio.
\newcommand{\ndcornerlogoheight}{1.3cm}

\newsavebox{\nd@cornerlogobox}
\savebox{\nd@cornerlogobox}{\includegraphics[height=\ndcornerlogoheight]{logos/academic-mark/\nd@mark/\nd@logo}}
\newlength{\ndcornerlogowidth}
\settowidth{\ndcornerlogowidth}{\usebox{\nd@cornerlogobox}}

% \ndcornerlogo -- draws the corner logo. Called automatically as the
% frame background when [cornerlogo] is set; can also be called
% directly (e.g. from \setbeamertemplate{background}{\ndcornerlogo} in
% a specific deck) if a deck wants more control than the option gives.
\newcommand{\ndcornerlogo}{%
  \begin{tikzpicture}[remember picture, overlay]
    \node[anchor=south west, xshift=\ndcornerlogomargin, yshift=\ndcornerlogomargin]
      at (current page.south west) {\usebox{\nd@cornerlogobox}};
  \end{tikzpicture}%
}
\ifbeamer@cornerlogo
  \setbeamertemplate{background}{\ndcornerlogo}
\fi

% \ndlogonote[align]{text} -- a note box in the white space to the
% right of the corner logo: horizontally centered between the logo's
% right edge and the slide's right edge, vertically centered on the
% logo's own vertical middle. For a short takeaway line (the common
% case, [align] defaults to center) or a left-aligned reference list
% (pass [left]). Works whether or not [cornerlogo] is set -- it
% measures the logo's actual size either way, so it stays aligned with
% \ndcornerlogo if that's also in use, or can be paired with a deck's
% own corner logo of the same size.
\newlength{\nd@notegap}
\setlength{\nd@notegap}{4mm}
\newlength{\nd@noteRmargin}
\setlength{\nd@noteRmargin}{3mm}
\newcommand{\ndlogonote}[2][center]{%
  \begin{tikzpicture}[remember picture, overlay]
    \coordinate (nd@logoR) at ($(current page.south west) + (\ndcornerlogomargin+\ndcornerlogowidth+\nd@notegap, \ndcornerlogomargin+0.5*\ndcornerlogoheight)$);
    \coordinate (nd@pageR) at ($(current page.south east) + (-\nd@noteRmargin, \ndcornerlogomargin+0.5*\ndcornerlogoheight)$);
    \node[anchor=center, align=#1,
          text width=\dimexpr\paperwidth-\ndcornerlogomargin-\ndcornerlogowidth-\nd@notegap-\nd@noteRmargin\relax]
      at ($(nd@logoR)!0.5!(nd@pageR)$) {#2};
  \end{tikzpicture}%
}

% Disable the navigation bar unless it was explicitly requested
\ifbeamer@nav
\else
  \setbeamertemplate{navigation symbols}{}
\fi

\ifbeamer@fullFooter
	\setbeamertemplate{footline}[footTitleAuthorDate]
\else
	\ifbeamer@noslidenumbers
	\else
		\setbeamertemplate{footline}[footerSimple]
	\fi
\fi

\mode<all>
